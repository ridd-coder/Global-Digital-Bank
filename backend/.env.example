# ─────────────────────────────────────────────────────────────
# Global Digital Bank — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./gdb_demo.db

# ── JWT ──────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ── Admin Credentials ────────────────────────────────────────
ADMIN_EMAIL=admin@globaldigitalbank.com
ADMIN_PASSWORD=Admin@SecurePass1

# ── Banking Rules ────────────────────────────────────────────
MIN_AGE=18
MIN_BALANCE_SAVINGS=1000.0
MIN_BALANCE_CURRENT=5000.0
DAILY_WITHDRAWAL_LIMIT=50000.0
MAX_FAILED_ATTEMPTS=3

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# ── App ──────────────────────────────────────────────────────
APP_NAME=Global Digital Bank
APP_ENV=development
DEBUG=true
BACKEND_PORT=8000
